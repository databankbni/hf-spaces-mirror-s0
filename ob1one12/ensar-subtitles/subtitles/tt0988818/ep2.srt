<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu herifleri ne yapayım?</font></font></b></b></font>

624
00:33:11,730 --> 00:33:12,730
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İcaplarına bak.</font></font></b></b></font>

625
00:33:15,490 --> 00:33:17,180
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Endişe etme, Katou.</font></font></b></b></font>

626
00:33:17,330 --> 00:33:20,760
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Yakında evini ya da başka bir şeyi sorun etmene gerek kalmayacak.</font></font></b></b></font>

627
00:33:20,760 --> 00:33:24,060
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sonuçta, burada un ufak edileceksin.
</font></font></b></b></font>

628
00:33:25,170 --> 00:33:26,180
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Un ufak edilmek mi?</font></font></b></b></font>

629
00:33:28,030 --> 00:33:32,200
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Limanı temizleyin. Kiyashimura Bir, kalkış için hazır.</font></font></b></b></font>

630
00:33:32,200 --> 00:33:35,040
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Kiyashimura Bir, kalkış için hazır.</font></font></b></b></font>

631
00:33:37,450 --> 00:33:38,930
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İşimize koyulalım.</font></font></b></b></font>

632
00:33:38,930 --> 00:33:39,930
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Gidiyoruz.</font></font></b></b></font>

633
00:33:56,570 --> 00:33:57,770
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İyice bir bakın.</font></font></b></b></font>

634
00:33:58,360 --> 00:34:00,650
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu Edo'yu son görüşümüz.</font></font></b></b></font>

635
00:34:06,350 --> 00:34:06,940
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İşe yaramıyor.</font></font></b></b></font>

636
00:34:07,750 --> 00:34:09,880
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hey, sizler de yardım edin!</font></font></b></b></font>

637
00:34:09,880 --> 00:34:12,350
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Haydi, Kagura, bir şeyler yap.</font></font></b></b></font>

638
00:34:12,350 --> 00:34:13,350
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sen Yato Klanı'ndan değil misin?</font></font></b></b></font>

639
00:34:13,350 --> 00:34:15,010
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Yapamam.</font></font></b></b></font>

640
00:34:15,170 --> 00:34:17,780
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Gördüğüm tüm yemeği bitirene kadar kılımı kıpırdatmam.</font></font></b></b></font>

