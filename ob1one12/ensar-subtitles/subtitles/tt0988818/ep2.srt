<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu...</font></font></b></b></font>

205
00:10:19,280 --> 00:10:20,280
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sinüs enfeksiyonu?</font></font></b></b></font>

206
00:10:20,280 --> 00:10:21,280
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Deprem oluyor be, salak!</font></font></b></b></font>

207
00:10:24,730 --> 00:10:25,860
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Durdu gibi.</font></font></b></b></font>

208
00:10:25,860 --> 00:10:28,190
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Son zamanlarda pekçok deprem oluyor.</font></font></b></b></font>

209
00:10:29,200 --> 00:10:29,420
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Evet.</font></font></b></b></font>

210
00:10:29,770 --> 00:10:31,730
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Dünya, aynı çatı altında yaşayan...</font></font></b></b></font>

211
00:10:31,730 --> 00:10:34,500
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...beş kişilik bir liseli delikanlı grubundan bile daha gürültücü.</font></font></b></b></font>

212
00:10:34,510 --> 00:10:37,320
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu normal değil, değil mi?</font></font></b></b></font>

213
00:10:37,650 --> 00:10:39,860
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Pekala Jump'ta oluyor.</font></font></b></b></font>

214
00:10:41,140 --> 00:10:42,110
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Müşteri mi?</font></font></b></b></font>

215
00:10:42,110 --> 00:10:44,790
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Olamaz, muhtemelen gazete falan satan bir satıcıdır.</font></font></b></b></font>

216
00:10:44,790 --> 00:10:47,460
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Shinpachi, Nikkei'den başka biriyse...</font></font></b></b></font>

217
00:10:47,460 --> 00:10:49,780
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...onlara istemediğimizi söyle ve geri gönder.</font></font></b></b></font>

218
00:10:49,780 --> 00:10:50,780
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Eğer gelen Nikkei'yse...</font></font></b></b></font>

219
00:10:50,780 --> 00:10:53,700
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...onu yeni doğan bir güneş gibi kibarca geri çevir.</font></font></b></b></font>

220
00:10:54,870 --> 00:10:57,100
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Tamam, tamam, geliyorum.</font></font></b></b></font>

221
00:10:57,200 --> 00:10:59,000
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Gazetemizi çoktan aldık.</font></font></b></b></font>

222
00:11:08,000 --> 00:11:08,720
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Umm...</font></font></b></b></font>

223
00:11:09,890 --> 00:11:14,420
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Buranın istediğimiz her şeyi yapan yer olduğunu duydum.</font></font></b></b></font>

224
00:11:16,650 --> 00:11:18,300
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Shinpachi, napıyorsun?</font></font></b></b></font>

225
00:11:18,300 --> 00:11:21,050
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Acele etmezsen programın başlayacak.</font></font></b></b></font>

226
00:11:21,060 --> 00:11:23,930
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Dediklerine göre, Yorozuya'ymışsınız.</font></font></b></b></font>

227
00:11:25,780 --> 00:11:28,690
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Tanrım, gerçekten o kadar ısrarcı mı?</font></font></b></b></font>

228
00:11:28,690 --> 00:11:31,970
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Eğer  vazgeçmiyorsa, kıçını tekmeleyeceğinizi ve--</font></font></b></b></font>

229
00:11:31,970 --> 00:11:33,750
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Burası Yorozuya, değil mi?</font></font></b></b></font>

230
00:11:38,790 --> 00:11:41,340
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Merhaba? Merhaba? Burda mısınız?</font></font></b></b></font>

231
00:11:41,350 --> 00:11:43,760
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">S-sen...Olamaz!</font></font></b></b></font>

232
00:11:44,640 --> 00:11:45,670
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Müşteri misin!?</font></font></b></b></font>

233
00:11:48,380 --> 00:11:49,510
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Katou Ken.</font></font></b></font>

234
00:11:49,510 --> 00:11:51,590
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bir ronin ve bu bölümün müşterisi.</font></font></b></b></font>

235
00:11:49,510 --> 00:11:51,590
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bir ronin ve bu bölümün müşterisi.</font></font></b></b></font>

236
00:11:49,510 --> 00:11:51,590
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Katou Ken</font></font></b></font>

237
00:11:52,360 --> 00:11:56,260
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Kendimi tanıtayım. Ben, Katou Ken.</font></font></b></b></font>

238
00:11:56,270 --> 00:11:58,390
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Son birkaç senedir bir ronin'im.</font></font></b></b></font>

239
00:11:59,330 --> 00:12:01,480
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hey, burada neler oluyor?</font></font></b></b></font>

240
00:12:01,480 --> 00:12:05,870
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Yakın aralıklarla iki müşterinin gelmesi... bu olamaz!</font></font></b></b></font>

241
00:12:06,350 --> 00:12:09,350
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ça..ça..ça-çayınız.</font></font></b></b></font>

242
00:12:11,080 --> 00:12:12,040
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Uum...</font></font></b></b></font>

243
00:12:12,250 --> 00:12:14,610
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu bir şaka falansa, seni ortadan ikiye ayırırım.</font></font></b></b></font>

244
00:12:14,610 --> 00:12:17,500
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne? Müşterimizle kavga başlatmaya falan mı çalışıyorsun?</font></font></b></b></font>

245
00:12:18,770 --> 00:12:19,820
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ziyaretinizi neye borçluyuz?</font></font></b></b></font>

246
00:12:20,270 --> 00:12:24,830
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Şey, ben kaybettiğim bir şeyin bulunmasını istiyordum.</font></font></b></b></font>

247
00:12:24,830 --> 00:12:28,540
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Benim için çok önemli bir şeydi, ama artık yok.</font></font></b></b></font>

248
00:12:30,020 --> 00:12:32,980
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Uhm, kaybettiğiniz şey nedir?</font></font></b></b></font>

249
00:12:32,980 --> 00:12:36,590
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Şey... ama 30 milyon yen'im olsaydı geri alabilirdim...</font></font></b></b></font>

250
00:12:36,880 --> 00:12:37,880
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Aptal keltoş!</font></font></b></b></font>

251
00:12:37,880 --> 00:12:40,910
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sana eğer bunlar bir şakaysa kıçına tekmeyi yersin dediğimi unuttun mu?</font></font></b></b></font>

252
00:12:41,630 --> 00:12:43,900
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne acı, her ona uzanıp dokunduğumuzu düşündüğümüzde...</font></font></b></b></font>

253
00:12:43,900 --> 00:12:47,000
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...parmaklarımızın arasından kayıp gidiyor.</font></font></b></b></font>

254
00:12:47,000 --> 00:12:51,000
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Demek sebebi buydu? Bu el bütün paramızı kumarda harcadı!</font></font></b></b></font>

255
00:12:51,310 --> 00:12:54,870
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ama her işi kabul edebileceğinizi düşünmüştüm.</font></font></b></b></font>

256
00:12:54,870 --> 00:12:57,330
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Evimizin kirasını bile ödeyemiyoruz!</font></font></b></b></font>

257
00:12:57,330 --> 00:12:59,330
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sen kendini ne sanıyorsun da...</font></font></b></b></font>

258
00:12:59,330 --> 00:13:01,190
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...kel kafanı buraya sokmuş, bize böyle bir teklifte bulunuyorsun?!</font></font></b></b></font>

259
00:13:01,550 --> 00:13:03,320
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Siz ikiniz, kendinize gelin.</font></font></b></b></font>

260
00:13:03,040 --> 00:13:07,120
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Her neyse, o parayla ne yapmayı düşünüyorsun?</font></font></b></b></font>

261
00:13:08,330 --> 00:13:12,660
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bakın, bir ay önce, Madogiwa Grubu'ndan kovuldum ve işsiz kaldım.</font></font></b></b></font>

262
00:13:14,220 --> 00:13:19,470
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sonra, üç hafta önce, dolandırıldım ve evimi elimden aldılar.</font></font></b></b></font>

263
00:13:20,960 --> 00:13:26,030
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sonra, iki hafta önce, karım ve kızım bir not bile bırakmadan beni terketti.</font></font></b></b></font>

264
00:13:28,350 --> 00:13:29,480
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sonra, bir hafta önce...</font></font></b></b></font>

265
00:13:37,460 --> 00:13:39,620
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne diye en önemli yerinde durmak zorundasın ki? Beni sinirlendiriyorsun!</font></font></b></b></font>

266
00:13:39,620 --> 00:13:43,740
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bir hafta önce, şu son birkaç aydır başına gelen talihsizliklerden daha beter ne oldu?!</font></font></b></b></font>

267
00:13:43,740 --> 00:13:46,370
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bir hafta önce ne oldu!?</font></font></b></b></font>

268
00:13:47,110 --> 00:13:49,870
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Devamını duymak istiyor musunuz?</font></font></b></b></font>

269
00:13:53,510 --> 00:13:56,950
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İşi bitirdikten sonra devamını duyabilirsiniz de ne demek öyle?</font></font></b></b></font>

270
00:13:56,950 --> 00:14:00,470
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İşi bitirip bitiremeyeceğimizden bile emin değilim ki.</font></font></b></b></font>

271
00:14:01,270 --> 00:14:03,740
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Şey, nereye gidiyoruz?</font></font></b></b></font>

272
00:14:03,740 --> 00:14:08,730
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Parayı en kısa zamanda almamız en iyisi değil mi?</font></font></b></b></font>

273
00:14:09,930 --> 00:14:12,760
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ooo, hoş geldiniz... Ah, sizmişsiniz.</font></font></b></b></font>

274
00:14:12,770 --> 00:14:13,520
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Otose</font></font></b></font>

275
00:14:13,560 --> 00:14:17,850
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Otose</font></font></b></font>

276
00:14:13,560 --> 00:14:17,850
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Bu Otose-san. Otose'nin Aperatif Dükkanı'nı işletiyor ve Gin-chan'ın ev sahibesi.</font></font></b></b></font>

277
00:14:20,360 --> 00:14:21,520
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Anlıyorum.</font></font></b></b></font>

278
00:14:21,520 --> 00:14:24,860
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Bu kadar parayı hızlı bir şekilde elde etmenin bir yolu olsaydı...</font></font></b></b></font>

279
00:14:24,860 --> 00:14:29,570
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> ...bu dünyada hırsız falan olmazdı!</font></font></b></b></font>

280
00:14:29,570 --> 00:14:31,490
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Hırsız olan sensin!</font></font></b></b></font>

281
00:14:31,490 --> 00:14:32,490
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Gerçekten.</font></font></b></b></font>

282
00:14:32,910 --> 00:14:33,490
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16"> Catherine</font></font></b></font>

283
00:14:33,500 --> 00:14:38,170
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16"> Catherine</font></font></b></font>

284
00:14:33,500 --> 00:14:38,170
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Bu, Catherine. Otose'nin Aperatif Yeri'nde bir çalışan. Dünyaya, para kazanmaya geldi.</font></font></b></b></font>

285
00:14:40,330 --> 00:14:43,340
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Pekala, başka seçeneğimiz yok değil.</font></font></b></b></font>

286
00:14:43,670 --> 00:14:44,590
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="12"> Karaborsa Kliniği</font></font></b></font>

287
00:14:45,510 --> 00:14:47,510
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Pekala o zaman beyler, sonuç nedir?</font></font></b></b></font>

288
00:14:47,510 --> 00:14:48,510
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Uhhm, ben...</font></font></b></b></font>

289
00:14:49,590 --> 00:14:51,930
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Senden bundan iki tane var zaten, birinden vazgeç!</font></font></b></b></font>

290
00:14:52,800 --> 00:14:54,350
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sıkıyorsa yap bakalım.</font></font></b></b></font>

291
00:14:54,640 --> 00:14:55,850
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu bir işe yaramıyor.</font></font></b></b></font>

292
00:14:56,480 --> 00:14:58,940
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Tanrım, dediğin kadar da her şeye çare bulabilen biri değilsin.</font></font></b></b></font>

293
00:14:59,900 --> 00:15:03,190
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hiç, bir insan azıcık para için bir organından vazgeçebilir mi?</font></font></b></b></font>

294
00:15:03,190 --> 00:15:06,150
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hiç sanmıyorum. Akıllı birinin bunu yapabileceğini sanmıyorum.</font></font></b></b></font>

295
00:15:12,280 --> 00:15:14,080
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ah, herkese merhabalar. Tanıştığıma memnun oldum.</font></font></b></b></font>

296
00:15:14,120 --> 00:15:15,620
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16"> Sarutobi Ayame</font></font></b></font>

297
00:15:15,620 --> 00:15:19,710
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Diğer bir deyişle; Sacchan. Oniwaban Sarayı'nın eski koruyucularından. Seçkin bir ninja.</font></font></b></b></font>

298
00:15:15,620 --> 00:15:19,710
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16"> Sarutobi Ayame</font></font></b></font>

299
00:15:20,250 --> 00:15:23,670
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ha? Çok miktarda para bulmanın kısa bir yolu mu?</font></font></b></b></font>

300
00:15:24,290 --> 00:15:26,800
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sacchan-san, gözlüklerini tak.</font></font></b></b></font>

301
00:15:26,800 --> 00:15:29,220
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Diğer müşterileri rahatsız ediyorsun.</font></font></b></b></font>

302
00:15:29,220 --> 00:15:31,720
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Aynı tipte karakter olduğumuzu sorun etmem.</font></font></b></b></font>

303
00:15:32,180 --> 00:15:32,720
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne diyorsun?</font></font></b></b></font>

304
00:15:32,720 --> 00:15:36,640
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Seni azıcık da olsa umursamıyorum.</font></font></b></b></font>

305
00:15:37,520 --> 00:15:39,020
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Benim umursadığım tek kişi...</font></font></b></b></font>

306
00:15:42,270 --> 00:15:44,480
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...sensin, Gin-san.</font></font></b></b></font>

307
00:15:46,360 --> 00:15:48,570
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sana gözlüklerini tak diyorum!</font></font></b></b></font>

308
00:15:49,490 --> 00:15:50,820
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Anlıyorum.</font></font></b></b></font>

309
00:15:50,860 --> 00:15:54,280
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Çeyizimizde para yoktu değildi, Gin-san.</font></font></b></b></font>

310
00:15:54,910 --> 00:15:56,870
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne diye seni seveyim?</font></font></b></b></font>

311
00:15:56,870 --> 00:15:59,660
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İşinden dolayı bir sevgilin bile olamaz.</font></font></b></b></font>

312
00:16:00,210 --> 00:16:01,750
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Her zamanki soğuk tavırlar...</font></font></b></b></font>

313
00:16:01,750 --> 00:16:04,880
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...ama bu tür bir uyarıdan sonra bile vazgeçmeyeceğim.</font></font></b></b></font>

314
00:16:04,880 --> 00:16:07,210
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hey, o natto ne için?</font></font></b></b></font>

315
00:16:07,210 --> 00:16:10,550
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Beni bununla tavlamaya çalışıyorsan, yanlış yoldasın.</font></font></b></b></font>

316
00:16:10,550 --> 00:16:14,760
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Beni kendinden uzaklaştırarak mutlu olacağımı mı sanıyorsun?</font></font></b></b></font>

317
00:16:14,760 --> 00:16:18,930
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Alış artık buna, seni natto-kadın!</font></font></b></b></font>

318
00:16:20,810 --> 00:16:22,350
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Doğru diyorsun.</font></font></b></b></font>

319
00:16:22,350 --> 00:16:24,350
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Kesinlikle haklısın.</font></font></b></b></font>

320
00:16:24,360 --> 00:16:26,270
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İstediğim bu, bu benim tutkum.</font></font></b></b></font>

321
00:16:26,730 --> 00:16:28,650
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Beni bu baştan çıkarıyor!</font></font></b></b></font>

322
00:16:29,820 --> 00:16:31,780
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu da ne? Pis kokuyor!</font></font></b></b></font>

323
00:16:31,780 --> 00:16:33,910
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Natto kokusu mu onu baştan çıkarıyormuş?</font></font></b></b></font>

324
00:16:36,700 --> 00:16:37,780
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Katou.</font></font></b></b></font>

325
00:16:41,910 --> 00:16:44,330
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hey, Katou, nasıl gidiyor?</font></font></b></b></font>

326
00:16:44,330 --> 00:16:45,330
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ah, ben...</font></font></b></b></font>

327
00:16:49,000 --> 00:16:50,210
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne fena, değil mi?</font></font></b></b></font>

328
00:16:50,220 --> 00:16:55,010
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İşte, insan bir belgeyi imzalamadan önce dikkatli olmalı.</font></font></b></b></font>

329
00:16:55,010 --> 00:17:00,430
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Görünüşe göre, bunun dışında da problemlerin varmış, değil mi?</font></font></b></b></font>

330
00:17:00,430 --> 00:17:01,430
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ha, siz nasıl biliyorsunuz?</font></font></b></b></font>

331
00:17:03,640 --> 00:17:05,480
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Neyse, bu aralar ne yapıyorsun?</font></font></b></b></font>

332
00:17:06,190 --> 00:17:08,860
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ah, onu bunu işte, evimi tekrardan satın alma gibi bir amacım var.</font></font></b></b></font>

333
00:17:08,860 --> 00:17:10,570
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Tekrardan almak mı? Bu hiçbir zaman gerçekleşmeyecek.</font></font></b></b></font>

334
00:17:10,570 --> 00:17:12,030
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu hiçbir zaman gerçekleşmeyecek.</font></font></b></b></font>

335
00:17:12,440 --> 00:17:13,860
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sonuçta, o artık biz--</font></font></b></b></font>

336
00:17:13,900 --> 00:17:14,400
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hey!</font></font></b></b></font>

337
00:17:15,490 --> 00:17:17,370
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Aaa, doğru ya!</font></font></b></b></font>

338
00:17:17,370 --> 00:17:20,240
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Eğer bir ev falan alırsan, bana haber ver.</font></font></b></b></font>

339
00:17:20,330 --> 00:17:22,750
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">En azından bir Yeni Yıl kartı gönderirim.</font></font></b></b></font>

340
00:17:24,370 --> 00:17:25,210
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Git bir duş al!</font></font></b></b></font>

341
00:17:25,210 --> 00:17:26,210
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Gelecek hafta görüşürüz</font></font></b></b></font>

342
00:17:29,000 --> 00:17:29,960
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hey, sen.</font></font></b></b></font>

343
00:17:29,960 --> 00:17:30,960
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Efendim?</font></font></b></b></font>

344
00:17:31,800 --> 00:17:35,180
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İstediğini değiştir, eğer onları öldürmemi istiyorsan onay vermen yeter.</font></font></b></b></font>

345
00:17:35,180 --> 00:17:37,260
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sonuçta bu benim mesleğim.</font></font></b></b></font>

346
00:17:37,260 --> 00:17:41,600
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Onları öldürelim! Tam şu an onları nehire atmalıyız.</font></font></b></b></font>

347
00:17:41,600 --> 00:17:43,270
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Yo, bekleyin.</font></font></b></b></font>

348
00:17:44,520 --> 00:17:46,440
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sözleşmemizin şartlarını değiştireceğim...</font></font></b></b></font>

349
00:17:47,150 --> 00:17:49,730
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...ama öldürmenizi söylemiyorum.</font></font></b></b></font>

350
00:17:51,480 --> 00:17:54,240
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Güçlenmek istiyorum.</font></font></b></b></font>

351
00:17:54,240 --> 00:17:56,570
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Sorun değil!</font></font></b></b></font>

352
00:17:56,570 --> 00:17:57,570
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hey, siz.</font></font></b></b></font>

353
00:17:59,530 --> 00:18:00,410
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Oof, her neyse.</font></font></b></b></font>

354
00:18:00,410 --> 00:18:03,950
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne olursa olsun, canını 100 kadar falan yükseltin.</font></font></b></b></font>

355
00:18:08,170 --> 00:18:10,290
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Benim halledecek başka işlerim var.</font></font></b></b></font>

356
00:18:13,960 --> 00:18:15,130
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">İşte burada.</font></font></b></b></font>

357
00:18:15,720 --> 00:18:19,300
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Planlar bunlar mı?</font></font></b></b></font>

358
00:18:20,100 --> 00:18:21,890
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Kondo Isao</font></font></b></font>

359
00:18:21,890 --> 00:18:24,270
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Shinsengumi'nin ürkütücü kaptanı.</font></font></b></b></font>

360
00:18:21,890 --> 00:18:24,270
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Kondo Isao</font></font></b></font>

361
00:18:25,270 --> 00:18:26,190
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu arada, Hijikata...</font></font></b></b></font>

362
00:18:27,810 --> 00:18:30,060
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...bundan hiçbir şey anlamadım ben.</font></font></b></b></font>

363
00:18:30,900 --> 00:18:36,070
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">On dakikadır, bunun bir Amanto mekanizmasının...</font></font></b></b></font>

364
00:18:34,480 --> 00:18:37,240
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...planları olduğundan bahsediyorum, Kondo-san.</font></font></b></b></font>

365
00:18:37,240 --> 00:18:38,240
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Aa, evet, doğru ya.</font></font></b></b></font>

366
00:18:38,240 --> 00:18:39,240
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bir çeşit makina mı bu?</font></font></b></b></font>

367
00:18:40,660 --> 00:18:43,950
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Demek Edo'da bir yerlerde bu aleti kullanıp...</font></font></b></b></font>

368
00:18:43,950 --> 00:18:45,790
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...kötü dolaplar çevirmek isteyen birisi var.</font></font></b></b></font>

369
00:18:47,830 --> 00:18:49,080
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bekle...</font></font></b></b></font>

370
00:18:50,920 --> 00:18:53,920
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Kötü dolaplar ne demek?</font></font></b></b></font>

371
00:18:55,590 --> 00:18:57,590
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Beni hiç dinlemedin mi sen?!</font></font></b></b></font>

372
00:19:11,560 --> 00:19:14,110
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16"> "Amanto Elçiliği"</font></font></b></font>

373
00:19:18,200 --> 00:19:19,110
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Amanto Elçiliği...</font></font></b></b></font>

374
00:19:19,700 --> 00:19:20,110
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Gintoki.</font></font></b></b></font>

375
00:19:21,570 --> 00:19:22,490
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Zura?</font></font></b></b></font>

376
00:19:22,700 --> 00:19:24,740
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22"> Zura değil, Katsura.</font></font></b></b></font>

377
00:19:24,740 --> 00:19:26,750
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Katsura Kotarou</font></font></b></font>

378
00:19:26,790 --> 00:19:32,130
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Eylemci. Amanto'ları, Edo'dan sürmeye ant içti.</font></font></b></b></font>

379
00:19:26,790 --> 00:19:32,130
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Katsura Kotarou</font></font></b></font>

380
00:19:33,210 --> 00:19:34,590
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Elizabeth</font></font></b></font>

381
00:19:34,590 --> 00:19:36,380
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu da ne böyle?!</font></font></b></b></font>

382
00:19:34,590 --> 00:19:36,380
<font face="Tahoma" size="24"><b><font color="#1a0d0d"><font size="16">Elizabeth</font></font></b></font>

383
00:19:36,800 --> 00:19:39,380
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Gintoki, böyle bir yerde ne işin var?</font></font></b></b></font>

384
00:19:39,380 --> 00:19:46,390
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hmm, sanırım, yürüyüşe çıkmak falan gibi garip şeyler yapıyorum.</font></font></b></b></font>

385
00:19:46,390 --> 00:19:48,020
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">O zaman iyi.</font></font></b></b></font>

386
00:19:49,560 --> 00:19:50,600
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu da ne demek?</font></font></b></b></font>

387
00:19:51,190 --> 00:19:54,360
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Etrafta garip söylentiler duydum.</font></font></b></b></font>

388
00:19:54,360 --> 00:19:55,360
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Söylentiler mi?</font></font></b></b></font>

389
00:19:55,360 --> 00:20:00,610
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Edo'yu tamamiyle yok etmeyi isteyen bir Amanto'nun olduğu gibi söylentiler.</font></font></b></b></font>

390
00:20:01,410 --> 00:20:04,410
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Neden bir Amanto bunu yapmak istesin ki?</font></font></b></b></font>

391
00:20:04,870 --> 00:20:05,700
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bilmiyorum.</font></font></b></b></font>

392
00:20:05,740 --> 00:20:09,500
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ama adaletin yerine gelmesi an meselesi.</font></font></b></b></font>

393
00:20:10,830 --> 00:20:15,090
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Gintoki, neyin peşinde olduğunu bilmiyorum, ama dikkat etsen iyi olur.</font></font></b></b></font>

394
00:20:15,090 --> 00:20:18,260
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Amanto Elçiliği, tamamen bambaşka bir ulus olarak sayılıyor.</font></font></b></b></font>

395
00:20:18,960 --> 00:20:20,550
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Başka bir ulus, ha?</font></font></b></b></font>

396
00:20:21,800 --> 00:20:23,340
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">O zaman tamam, dikkat etmeliyim.</font></font></b></b></font>

397
00:20:24,050 --> 00:20:25,050
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Görüşürüz, Zura.</font></font></b></b></font>

398
00:20:26,600 --> 00:20:28,810
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Zura değil, Katsura.</font></font></b></b></font>

399
00:20:41,240 --> 00:20:42,990
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu tip şapkalar moda mı?</font></font></b></b></font>

400
00:20:49,370 --> 00:20:51,040
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Şimdi sen dene.</font></font></b></b></font>

401
00:20:51,040 --> 00:20:52,040
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bunu yapamaz!</font></font></b></b></font>

402
00:20:52,620 --> 00:20:54,960
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne diyorsun ya? Bu çok basit!</font></font></b></b></font>

403
00:20:55,500 --> 00:20:58,130
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Tek yapman gereken konsantre olmak. Zihin maddeden üstündür.</font></font></b></b></font>

404
00:20:58,130 --> 00:21:00,170
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Neden bahsettiğini anlamıyorum bile.</font></font></b></b></font>

405
00:21:02,720 --> 00:21:05,340
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ne olursa olsun, eğer yapabiliyorsan, bana saldır.</font></font></b></b></font>

406
00:21:14,940 --> 00:21:17,270
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Neden gözlerini saklıyorsun?</font></font></b></b></font>

407
00:21:17,270 --> 00:21:18,270
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Tüm gece ayakta kalıp Tetris mi oynadın?</font></font></b></b></font>

408
00:21:19,940 --> 00:21:22,240
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Oyun, şimdi başlamak üzere.</font></font></b></b></font>

409
00:21:23,030 --> 00:21:23,820
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bırak ama.</font></font></b></b></font>

410
00:21:23,820 --> 00:21:27,120
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Öyle bir şeyi etrafta sallayıp durursan, birilerinin canı yanabilir.</font></font></b></b></font>

411
00:21:28,410 --> 00:21:31,410
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Burada bir kılıç sakladığımı anladı mı?</font></font></b></b></font>

412
00:21:32,160 --> 00:21:36,580
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ben sorun etmem, ama lütfen bana neden peşimde olduğunu söyler misin?</font></font></b></b></font>

413
00:21:36,580 --> 00:21:41,510
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Güldürme beni! Bu çevrede gizli gizli casusluk yaptığını biliyorum!</font></font></b></b></font>

414
00:21:42,010 --> 00:21:43,420
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Hayır, o ben değildim.</font></font></b></b></font>

415
00:21:43,920 --> 00:21:45,840
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Zura'ydı o.</font></font></b></b></font>

416
00:21:46,300 --> 00:21:47,800
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Fazla konuşma.</font></font></b></b></font>

417
00:21:52,640 --> 00:21:53,230
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Deprem mi?</font></font></b></b></font>

418
00:21:59,650 --> 00:22:01,190
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Çok açık veriyorsun!</font></font></b></b></font>

419
00:22:01,860 --> 00:22:03,530
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bu şekilde daha fazla</font></font></b></b></font>

420
00:22:04,400 --> 00:22:05,990
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">güçlenebileceğini düşünüyor musun?
</font></font></b></b></font>

421
00:22:07,990 --> 00:22:09,370
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Fazla sert davranıyorsun.</font></font></b></b></font>

422
00:22:09,990 --> 00:22:11,870
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Özür dilerim! İyi misiniz?!</font></font></b></b></font>

423
00:22:14,120 --> 00:22:15,870
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Ayağa kalk! Kalk, Katoken!</font></font></b></b></font>

424
00:22:16,830 --> 00:22:20,710
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Tamam, sadece ellerini kendine yakın tutacaksın.</font></font></b></b></font>

425
00:22:20,710 --> 00:22:22,300
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Yay gibi sarılı tutuyorsun...</font></font></b></b></font>

426
00:22:22,590 --> 00:22:23,300
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">...ve geçir!</font></font></b></b></font>

427
00:22:23,300 --> 00:22:24,920
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Geçir, geçir!</font></font></b></b></font>

428
00:22:24,920 --> 00:22:27,800
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">Bir dakika, bu nasıl yumruk geçirilir, değil mi?</font></font></b></b></font>

429
00:22:27,800 --> 00:22:28,800
<font face="Tahoma" size="24"><b><b><font face="Palatino Linotype"><font size="22">O yarına.</font></font></b></b></font>

430
00:22:29,890 --> 00:22:31,260
