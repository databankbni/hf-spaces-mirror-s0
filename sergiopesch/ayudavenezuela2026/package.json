{
  "name": "ayudavenezuela2026",
  "version": "1.0.0",
  "description": "AyudaVenezuela2026 is a concept foundation for a Venezuela-focused successor to the disaster-response work described in Hugging Face's 2023 post, [Using ML for Disasters](https://huggingface.co/blog/using-ml-for-disasters).",
  "type": "module",
  "main": "server/index.mjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build:data": "node scripts/build-trusted-data.mjs && node scripts/build-damage-view-index.mjs && node scripts/build-worst-hotspots.mjs && node scripts/cache-hotosm-damage-areas.mjs",
    "cache:damage": "node scripts/cache-microsoft-damage.mjs",
    "cache:damage-tiles": "node scripts/cache-damage-tiles.mjs",
    "cache:enhanced-satellite": "node scripts/cache-enhanced-satellite-tiles.mjs",
    "cache:enhanced-satellite-hotspots": "ENHANCED_TILE_MODE=hotspots ENHANCED_TILE_ZOOMS=18,19 ENHANCED_TILE_RADIUS=3 node scripts/cache-enhanced-satellite-tiles.mjs",
    "cache:enhanced-satellite-archive": "node scripts/cache-enhanced-satellite-archive.mjs",
    "cache:sentinel": "node scripts/cache-sentinel-tiles.mjs",
    "cache:hotosm-damage": "node scripts/cache-hotosm-damage-areas.mjs",
    "cache:osm-labels": "node scripts/cache-osm-named-places.mjs",
    "cache:sr-pilot": "node scripts/cache-real-esrgan-sr-pilot.mjs",
    "cache:swin2sr-pilot": "node scripts/cache-swin2sr-sr-pilot.mjs",
    "cache:map": "npm run cache:damage && npm run cache:damage-tiles && npm run cache:enhanced-satellite && npm run cache:sentinel && npm run cache:hotosm-damage",
    "build:app": "tsc -b && vite build",
    "build": "npm run build:data && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "qa:ui": "node scripts/qa-full.mjs",
    "qa:imagery": "node scripts/qa-imagery.mjs",
    "qa:zoom": "node scripts/qa-zoom.mjs",
    "qa:e2e": "npm run qa:ui && npm run qa:imagery",
    "perf:map": "node scripts/perf-map.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@huggingface/inference": "^4.13.19",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
