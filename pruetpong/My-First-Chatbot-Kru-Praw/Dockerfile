# =============================================================================
#  Dockerfile — สูตรสร้าง "กล่อง" (container) สำหรับ deploy บน Hugging Face Spaces
# -----------------------------------------------------------------------------
#  Docker ทำให้แอปรันได้เหมือนกันทุกที่ โดยรวม Python + ไลบรารี + โค้ด ไว้ในกล่องเดียว
#  HF Spaces (แบบ Docker) จะอ่านไฟล์นี้แล้ว build + run ให้อัตโนมัติ
# =============================================================================

FROM python:3.11-slim
# ↑ เริ่มจากอิมเมจ Python 3.11 รุ่น slim (เล็ก เบา เหมาะกับ deploy)

WORKDIR /app
# ↑ ตั้งโฟลเดอร์ทำงานในกล่องเป็น /app (คำสั่งถัดไปอ้างอิงจากที่นี่)

COPY requirements.txt .
# ↑ คัดลอกเฉพาะ requirements.txt เข้ามาก่อน (ทำชั้นนี้แยก เพื่อใช้ cache ตอน build ซ้ำได้เร็วขึ้น)

RUN pip install --no-cache-dir -r requirements.txt
# ↑ ติดตั้งไลบรารีตามรายการ (--no-cache-dir = ไม่เก็บ cache ทำให้อิมเมจเล็กลง)

COPY . .
# ↑ คัดลอกไฟล์ที่เหลือทั้งหมด (app.py, templates/ ฯลฯ) เข้ากล่อง

EXPOSE 7860
# ↑ ประกาศว่าแอปจะให้บริการที่พอร์ต 7860 (พอร์ตมาตรฐานของ HF Spaces)

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "7860"]
# ↑ คำสั่งเริ่มรันเมื่อกล่องทำงาน: เปิด uvicorn เสิร์ฟตัวแปร app จากไฟล์ app.py
#   --host 0.0.0.0 = รับการเชื่อมต่อจากภายนอกกล่อง (จำเป็นสำหรับ container)