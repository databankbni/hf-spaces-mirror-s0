FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
# Install CPU-only torch first to avoid pulling the CUDA variant from requirements.txt
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download the BGE embedding model at build time so cold starts are
# deterministic. Mirrors ingestion/embed.py: SentenceTransformer(_MODEL_NAME)
# with no custom cache env — model lands in /root/.cache/torch/sentence_transformers.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5')"

# serving/artifact/ (chunks.parquet + embeddings.npz) is generated by
# serving/export_artifact.py and must exist before building this image.
COPY api/ api/
COPY retrieval/ retrieval/
COPY ingestion/ ingestion/
COPY serving/ serving/

# GEMINI_API_KEY, LLM_BASE_URL, LLM_MODEL are injected at runtime via
# Hugging Face Space secrets — never baked into the image.
EXPOSE 7860

CMD ["uvicorn", "serving.space_app:app", "--host", "0.0.0.0", "--port", "7860"]
